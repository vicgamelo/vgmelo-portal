# Copy to .env and fill in. Never commit the real file.

# Postgres (shared instance on the VPS, own database/user)
DATABASE_URL=postgresql+psycopg://portal:CHANGE_ME@postgres:5432/portal
# 32+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

SITE_URL=https://vgmelo.tech
# Defaults to SITE_URL. Comma separated.
ALLOWED_ORIGINS=https://vgmelo.tech
# CIDR of the Docker network Caddy talks from. X-Forwarded-For is ignored from anyone else.
TRUSTED_PROXIES=172.18.0.0/16

# OAuth apps. Callbacks: https://vgmelo.tech/api/auth/google/callback and /api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend. Without RESEND_API_KEY, email login is off (Google/GitHub keep working) and contact
# messages are only stored.
RESEND_API_KEY=
EMAIL_FROM=vgmelo.tech <no-reply@vgmelo.tech>
# Where contact messages (and budget alerts) go. Keep it out of the site; empty: only stored.
CONTACT_TO=
# Who can open /admin (verified email, full session). Comma separated.
ADMIN_EMAILS=

# Quotas per user per day (QUOTA_TZ midnight) and the global token budget for the agents demo.
QUOTA_TZ=America/Sao_Paulo
QUOTA_AGENTS=5
QUOTA_SCORE=30
QUOTA_MCP=30
QUOTA_TRACES=200
GLOBAL_DAILY_TOKENS=300000
MAX_CONCURRENT_RUNS=2
# E-mail (via Resend) when today's tokens cross these % of GLOBAL_DAILY_TOKENS, once each. Empty: no alert.
ALERT_BUDGET_PERCENTS=80,100
# Empty ALERT_TO sends to CONTACT_TO.
ALERT_TO=
QUESTION_MAX_CHARS=500
MAX_BODY_BYTES=16384
# CSV of the credit batch demo (raw body). Caddy caps /api/* at 64 KB.
BATCH_MAX_BYTES=51200
BATCH_VALIDATE_PER_HOUR=30

# Internal services (Docker network, never public)
ORCHESTRATOR_URL=http://agent-orchestrator:8000
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_AGENT=
LENS_URL=http://genai-lens:8080
SCORING_URL=http://scoring:8000
MCP_URL=http://mcp-brasil:8000/mcp

# Optional tuning (defaults shown)
# SESSION_TTL_HOURS=168
# PENDING_MFA_TTL_MINUTES=15
# EMAIL_CODE_TTL_MINUTES=15
# LOCKOUT_WINDOW_MINUTES=15
# LOCKOUT_MAX_PER_ACCOUNT=5
# LOCKOUT_MAX_PER_IP=20
# REGISTER_MAX_PER_IP_HOUR=5
# REGISTER_MAX_PER_EMAIL_HOUR=3
# LOGIN_MAX_PER_IP_WINDOW=30
# OAUTH_START_MAX_PER_IP_WINDOW=30
# CONTACT_MAX_PER_IP_HOUR=5
# CONTACT_MIN_FILL_SECONDS=3
# LOG_LEVEL=INFO
